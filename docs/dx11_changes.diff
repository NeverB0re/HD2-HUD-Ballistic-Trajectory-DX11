+-- Empirical launch rule: G6/C4/beacon/K2 control20 ->22.4m/s; Melta4.5 ->10.63m/s.
+-- Shared animation-family release poses are estimates for items without recorded flight.
+for _, model in ipairs(catalog) do
+    if model.throwable then
+        model.muzzle = 'r_shoulder'
+        model.velocity_m_s = 22.4 * math.sqrt((model.throw_distance_control or 20) / 20)
+        model.effective_gravity_m_s2, model.quadratic_drag_k_m_inv = 9.8, 0
+        model.release_offset = model.release_offset or {.24,.762,.675}
+        model.launch_pitch_deg = model.launch_pitch_deg or 4.75
+    end
+end
+return catalog
 
 end)())
